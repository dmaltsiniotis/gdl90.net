{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "File in mode",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/GDL90.Console/bin/Debug/net10.0/GDL90.Console.dll",
            "args": [
                "--infile",
                "${workspaceFolder}/../gdl90_testdata/ADS-B_TEST-DATA-ENORMOUS.bin",
                "--benchmark",
                "--stats",
                "--experimental"
            ],
            "cwd": "${workspaceFolder}/GDL90.Console",
            "console": "integratedTerminal", // Changed from "internalConsole" becuase the demo application will wait for user input (press any key) to end the program.
            "stopAtEntry": false
        },
        {
            "name": "Standard UDP Mode",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/GDL90.Console/bin/Debug/net10.0/GDL90.Console.dll",
            "args": [
                "--loglevel",
                "4"
            ],
            "cwd": "${workspaceFolder}/GDL90.Console",
            "console": "integratedTerminal", // Changed from "internalConsole" becuase the demo application will wait for user input (press any key) to end the program.
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}